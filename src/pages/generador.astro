---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Generador de preguntas" description="Genera preguntas con Hugging Face desde tu navegador">
  <h1 class="text-3xl sm:text-4xl font-bold text-center py-6">Generador de preguntas con IA</h1>

  <div class="container mx-auto max-w-4xl p-4 sm:p-6 lg:p-8">
    <div class="rounded-3xl border-4 border-black bg-white p-5 sm:p-8 shadow-[10px_10px_0_0_rgba(0,0,0,0.9)]">
      <p class="mb-6 text-slate-700">
        Pega un texto o sube un documento y genera un tipo test. El token de Hugging Face se introduce aquí mismo y no se guarda en el proyecto.
      </p>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label class="block font-semibold mb-2" for="token">Token de Hugging Face</label>
          <input
            id="token"
            type="password"
            class="w-full rounded-lg border-2 border-slate-900 px-3 py-2"
            placeholder="hf_..."
            autocomplete="off"
          />
        </div>

        <div>
          <label class="block font-semibold mb-2" for="model">Modelo</label>
          <input
            id="model"
            class="w-full rounded-lg border-2 border-slate-900 px-3 py-2"
            value="google/flan-t5-small"
          />
        </div>

        <div>
          <label class="block font-semibold mb-2" for="title">Título del test</label>
          <input id="title" class="w-full rounded-lg border-2 border-slate-900 px-3 py-2" placeholder="Ej. Test Tema 1" />
        </div>

        <div>
          <label class="block font-semibold mb-2" for="subject">Asignatura</label>
          <input id="subject" class="w-full rounded-lg border-2 border-slate-900 px-3 py-2" placeholder="Ej. Matemáticas" />
        </div>

        <div>
          <label class="block font-semibold mb-2" for="career">Carrera</label>
          <input id="career" class="w-full rounded-lg border-2 border-slate-900 px-3 py-2" placeholder="Ej. Ingeniería Informática" />
        </div>

        <div>
          <label class="block font-semibold mb-2" for="year">Curso</label>
          <input id="year" class="w-full rounded-lg border-2 border-slate-900 px-3 py-2" placeholder="Ej. Primer año" />
        </div>

        <div>
          <label class="block font-semibold mb-2" for="num">Número de preguntas</label>
          <input id="num" type="number" min="1" value="10" class="w-full rounded-lg border-2 border-slate-900 px-3 py-2" />
        </div>

        <div>
          <label class="block font-semibold mb-2" for="file">Subir archivo</label>
          <input id="file" type="file" accept=".txt,.md,.pdf" class="block w-full rounded-lg border-2 border-slate-900 px-3 py-2 bg-white" />
        </div>
      </div>

      <div class="mt-4">
        <label class="block font-semibold mb-2" for="content">Texto del documento</label>
        <textarea
          id="content"
          rows="12"
          class="w-full rounded-xl border-2 border-slate-900 px-3 py-2"
          placeholder="Pega aquí el contenido o súbelo desde un archivo..."
        ></textarea>
      </div>

      <div class="mt-5 flex flex-wrap gap-3 items-center">
        <button id="generate" class="rounded-full bg-amber-500 px-5 py-3 font-bold text-slate-900 shadow-md transition hover:bg-amber-400 flex items-center" aria-live="polite">
          <svg id="spinner" class="w-5 h-5 mr-3 hidden animate-spin" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
          </svg>
          <span id="generate-text">Generar preguntas</span>
        </button>
        <button id="download" class="rounded-full bg-slate-900 px-5 py-3 font-bold text-white shadow-md transition hover:bg-slate-700" disabled>
          Descargar JSON
        </button>
      </div>

      <p id="status" class="mt-4 text-sm font-medium text-slate-700" aria-live="polite"></p>

      <div id="progress" class="mt-3 h-3 w-full rounded-full bg-slate-200 overflow-hidden hidden" aria-hidden="true">
        <div id="progress-fill" class="h-full bg-amber-500 w-0 transition-all"></div>
      </div>

      <div id="toast-container" class="fixed bottom-6 right-6 flex flex-col gap-3 z-50"></div>

      <h2 class="mt-8 text-xl font-bold">Resultado</h2>
      <pre id="output" class="mt-3 max-h-[32rem] overflow-auto rounded-2xl border-2 border-slate-900 bg-slate-100 p-4 text-sm whitespace-pre-wrap"></pre>
    </div>
  </div>

  <script type="module">
    import * as pdfjsLib from 'pdfjs-dist/build/pdf.mjs';

    pdfjsLib.GlobalWorkerOptions.workerSrc = new URL('pdfjs-dist/build/pdf.worker.mjs', import.meta.url).toString();

    const tokenEl = document.getElementById('token');
    const modelEl = document.getElementById('model');
    const titleEl = document.getElementById('title');
    const subjectEl = document.getElementById('subject');
    const careerEl = document.getElementById('career');
    const yearEl = document.getElementById('year');
    const numEl = document.getElementById('num');
    const fileEl = document.getElementById('file');
    const contentEl = document.getElementById('content');
    const generateBtn = document.getElementById('generate');
    const downloadBtn = document.getElementById('download');
    const outputEl = document.getElementById('output');
    const statusEl = document.getElementById('status');
    const spinner = document.getElementById('spinner');

    let lastResult = null;
    let generating = false;
    let progressInterval = null;
    let progressValue = 0;

    function setStatus(message) {
      statusEl.textContent = message;
    }

    function setGenerating(on) {
      generating = on;
      generateBtn.disabled = on;
      const genText = document.getElementById('generate-text');
      const progressEl = document.getElementById('progress');
      const progressFill = document.getElementById('progress-fill');
      if (on) {
        spinner.classList.remove('hidden');
        genText.textContent = 'Generando...';
        setStatus('Generando preguntas — esto puede tardar unos segundos');
        // show progress bar and start fake progress
        progressValue = 0;
        progressFill.style.width = '0%';
        progressEl.classList.remove('hidden');
        progressInterval = setInterval(() => {
          // increment with diminishing steps until 90%
          const step = Math.random() * 6 + 2; // 2-8%
          progressValue = Math.min(90, progressValue + step);
          progressFill.style.width = progressValue + '%';
        }, 500);
      } else {
        spinner.classList.add('hidden');
        genText.textContent = 'Generar preguntas';
        // finish progress
        const progressFill = document.getElementById('progress-fill');
        if (progressInterval) clearInterval(progressInterval);
        progressValue = 100;
        progressFill.style.width = '100%';
        setTimeout(() => {
          const progressEl = document.getElementById('progress');
          progressEl.classList.add('hidden');
          progressFill.style.width = '0%';
        }, 700);
      }
    }

    function showToast(message, type = 'info', timeout = 5000) {
      const container = document.getElementById('toast-container');
      if (!container) return;
      const toast = document.createElement('div');
      toast.className = `max-w-sm px-4 py-3 rounded-lg shadow-md text-sm font-medium ${
        type === 'error' ? 'bg-red-600 text-white' : type === 'success' ? 'bg-emerald-600 text-white' : 'bg-slate-800 text-white'
      }`;
      toast.textContent = message;
      container.appendChild(toast);
      setTimeout(() => {
        toast.classList.add('opacity-0');
        setTimeout(() => toast.remove(), 400);
      }, timeout);
    }

    function extractJson(text) {
      const first = text.indexOf('{');
      const last = text.lastIndexOf('}');
      if (first === -1 || last === -1 || last <= first) {
        return null;
      }
      try {
        return JSON.parse(text.slice(first, last + 1));
      } catch {
        return null;
      }
    }

    function ensureOutputShape(data, fallbackMeta) {
      const result = data && typeof data === 'object' ? data : {};
      result.title = result.title || fallbackMeta.title || 'Generado';
      result.career = result.career || fallbackMeta.career || '';
      result.year = result.year || fallbackMeta.year || '';
      result.subject = result.subject || fallbackMeta.subject || '';
      result.questions = Array.isArray(result.questions) ? result.questions : [];
      return result;
    }

    async function readPdf(file) {
      const data = new Uint8Array(await file.arrayBuffer());
      const pdf = await pdfjsLib.getDocument({ data }).promise;
      const pages = [];
      for (let i = 1; i <= pdf.numPages; i += 1) {
        const page = await pdf.getPage(i);
        const textContent = await page.getTextContent();
        pages.push(textContent.items.map((item) => item.str).join(' '));
      }
      return pages.join('\n\n');
    }

    fileEl?.addEventListener('change', async (event) => {
      const file = event.target.files && event.target.files[0];
      if (!file) return;

      setStatus('Leyendo documento...');
      try {
        let text = '';
        if (file.type === 'application/pdf' || file.name.toLowerCase().endsWith('.pdf')) {
          text = await readPdf(file);
        } else {
          text = await file.text();
        }
        contentEl.value = text;
        setStatus(`Documento cargado: ${file.name}`);
      } catch (error) {
        console.error(error);
        setStatus('No se pudo leer el documento.');
      }
    });

    generateBtn?.addEventListener('click', async () => {
      const token = tokenEl.value.trim();
      const model = modelEl.value.trim() || 'google/flan-t5-small';
      const text = contentEl.value.trim();
      const numQuestions = Math.max(1, Number(numEl.value) || 10);
      const meta = {
        title: titleEl.value.trim(),
        career: careerEl.value.trim(),
        year: yearEl.value.trim(),
        subject: subjectEl.value.trim(),
      };

      if (!token) {
        setStatus('Pega tu token de Hugging Face para continuar.');
        return;
      }

      if (!text) {
        setStatus('Introduce texto o sube un archivo.');
        return;
      }

      setGenerating(true);
      outputEl.textContent = 'Procesando...';
      downloadBtn.disabled = true;
      lastResult = null;

      const inputText = text.length > 7000 ? text.slice(0, 7000) : text;
      const prompt = [
        `Genera ${numQuestions} preguntas tipo test a partir del texto siguiente.`,
        'Devuelve únicamente JSON válido con esta estructura:',
        '{"title":"","career":"","year":"","subject":"","questions":[{"q":"","a":["","",""],"answer":0}]}',
        'Reglas:',
        '- Cada pregunta debe tener 3 o 4 respuestas.',
        '- answer debe ser el índice correcto empezando en 0.',
        '- No añadas explicación ni texto fuera del JSON.',
        '',
        inputText,
      ].join('\n');

      try {
        const response = await fetch(`https://api-inference.huggingface.co/models/${encodeURIComponent(model)}`, {
          method: 'POST',
          headers: {
            Authorization: `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            inputs: prompt,
            parameters: {
              max_new_tokens: 800,
              temperature: 0.4,
              return_full_text: false,
            },
          }),
        });

        const data = await response.json();
        const generatedText = Array.isArray(data)
          ? data.map((item) => item.generated_text || item.summary_text || '').join('\n')
          : data.generated_text || data.summary_text || JSON.stringify(data);

        const parsed = extractJson(generatedText);
        const finalResult = ensureOutputShape(parsed || { raw: generatedText }, meta);

        lastResult = finalResult;
        outputEl.textContent = JSON.stringify(finalResult, null, 2);
        setStatus(parsed ? 'Preguntas generadas correctamente.' : 'El modelo respondió, pero no devolvió JSON limpio. Revisa la salida.');
        downloadBtn.disabled = false;
        showToast(parsed ? 'Preguntas generadas correctamente.' : 'Generado (revisa JSON)', parsed ? 'success' : 'info');
      } catch (error) {
        console.error(error);
        outputEl.textContent = String(error);
        setStatus('Hubo un error al generar el test.');
        showToast('Error al generar el test. Comprueba el token y el modelo.', 'error');
      } finally {
        setGenerating(false);
      }
    });

    downloadBtn?.addEventListener('click', () => {
      if (!lastResult) return;
      const blob = new Blob([JSON.stringify(lastResult, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const anchor = document.createElement('a');
      anchor.href = url;
      anchor.download = `${(lastResult.title || 'generated').replace(/\s+/g, '_')}.json`;
      anchor.click();
      URL.revokeObjectURL(url);
    });
  </script>
</Layout>
